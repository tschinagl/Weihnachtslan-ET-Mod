+        float y = 100 + 30 * i;
+        CG_FillRect(x + 8, y, 394, 28, active ? selected : row);
+        CG_Text_Paint_Ext(x + 15, y + 12, 0.18f, 0.18f, enabled ? colorWhite : dim,
+            va("[%s] %s", active ? "X" : " ", bg_customOptions[i].name), 0, 0, 0, &cgs.media.limboFont2);
+        CG_Text_Paint_Ext(x + 355, y + 12, 0.18f, 0.18f, enabled ? accent : dim,
+            va("%i P", bg_customOptions[i].cost), 0, 0, 0, &cgs.media.limboFont2);
+        CG_Text_Paint_Ext(x + 35, y + 24, 0.14f, 0.14f, enabled ? colorWhite : dim,
+            bg_customOptions[i].description, 0, 0, 0, &cgs.media.limboFont2);
+    }
+    CG_Text_Paint_Ext(x + 12, 357, 0.16f, 0.16f, colorWhite, "Basis: SMG, Pistole, Messer, 2 Granaten", 0, 0, 0, &cgs.media.limboFont2);
+    CG_Text_Paint_Ext(x + 12, 373, 0.16f, 0.16f, accent, "Mit OK speichern - aktiv beim naechsten Spawn", 0, 0, 0, &cgs.media.limboFont2);
