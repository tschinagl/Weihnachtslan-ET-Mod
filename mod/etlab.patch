+/* Local opt-in practice fixtures only. No changes to normal map spawning. */
+void G_ETLabPracticeTargets(gentity_t *player)
+{
+	static const float angles[] = { 0, 15, -15, 30, -30, 45, -45, 60, -60, 75, -75, 90, -90, 120, -120, 150, -150, 180 };
+	vec3_t positions[4], start, end, facing, direction;
+	trace_t tr;
+	int i, j, ring, count = 0;
+	team_t enemy;
+	char map[MAX_QPATH];
+
+	if (!player->client || !player->client->pers.localClient || player->health <= 0 ||
+	    (player->client->sess.sessionTeam != TEAM_AXIS && player->client->sess.sessionTeam != TEAM_ALLIES) ||
+	    !trap_Cvar_VariableIntegerValue("g_etlabPractice") || trap_Cvar_VariableIntegerValue("dedicated"))
+	{
+		return;
+	}
+	trap_Cvar_VariableStringBuffer("mapname", map, sizeof(map));
+	if (Q_stricmp(map, "oasis"))
+	{
+		return;
+	}
+
+	// Remove only our own fixtures and their command-map markers, including after team changes.
+	for (i = MAX_CLIENTS; i < level.num_entities; i++)
+	{
+		gentity_t *target = &g_entities[i];
+		if (target->inuse && target->targetname && !Q_stricmp(target->targetname, "etlab_practice_target"))
+		{
+			for (j = 0; j < 2; j++)
+			{
+				mapEntityData_t *marker = G_FindMapEntityData(&mapEntityData[j], i);
+				if (marker) { G_FreeMapEntityData(&mapEntityData[j], marker); }
+			}
+			G_FreeEntity(target);
+		}
+	}
+
+	// Find dry, visible ground around the current spawn, never through walls or over a drop.
+	for (ring = 0; ring < 6 && count < 4; ring++)
+	{
+		for (i = 0; i < ARRAY_LEN(angles) && count < 4; i++)
+		{
+			VectorSet(facing, 0, player->client->ps.viewangles[YAW] + angles[i], 0);
+			AngleVectors(facing, direction, NULL, NULL);
+			VectorCopy(player->client->ps.origin, start);
+			start[2] += 24;
+			VectorMA(start, 160 + ring * 80, direction, end);
+			trap_Trace(&tr, start, NULL, NULL, end, player->s.number, MASK_SOLID);
+			if (tr.startsolid || tr.fraction < 1) { continue; }
+			VectorCopy(end, start);
+			end[2] -= 200;
+			trap_Trace(&tr, start, NULL, NULL, end, player->s.number, MASK_SOLID);
+			if (tr.startsolid || tr.fraction == 1 || tr.plane.normal[2] < 0.85f ||
+			    (tr.surfaceFlags & SURF_NOIMPACT)) { continue; }
+			tr.endpos[2] += 2;
+			if (trap_PointContents(tr.endpos, player->s.number) & MASK_WATER) { continue; }
+			for (j = 0; j < count; j++)
+			{
+				if (DistanceSquared(positions[j], tr.endpos) < Square(110)) { break; }
+			}
+			if (j < count) { continue; }
+			VectorCopy(tr.endpos, positions[count]);
+			count++;
+		}
+	}
+	if (count < 4)
+	{
+		trap_SendServerCommand(player->s.number, "cp \"ETLab: Go to open ground and press F6 for practice targets.\"");
+		G_Printf("ETLAB_PRACTICE_NO_SPACE: %d valid positions\n", count);
+		return;
+	}
+	enemy = player->client->sess.sessionTeam == TEAM_AXIS ? TEAM_ALLIES : TEAM_AXIS;
+	for (i = 0; i < 4; i++)
+	{
+		gentity_t *target = G_Spawn();
+		int weapon = i == 3 ? WP_DYNAMITE : WP_LANDMINE;
+		G_PreFilledMissileEntity(target, weapon, weapon, ENTITYNUM_WORLD, enemy,
+		                        player->s.number, &g_entities[ENTITYNUM_WORLD], positions[i], vec3_origin);
+		target->targetname = "etlab_practice_target";
+		G_SetOrigin(target, positions[i]);
+		target->s.groundEntityNum = ENTITYNUM_WORLD;
+		target->s.otherEntityNum = ENTITYNUM_WORLD;
+		target->timestamp = 0;
+		target->health = 0;
+		if (weapon == WP_LANDMINE)
+		{
+			target->s.effect1Time = 1;
+			target->takedamage = qtrue;
+			target->r.contents = 0;
+			target->r.snapshotCallback = qtrue;
+			target->think = G_LandminePrime;
+			target->nextthink = level.time + 2000;
+			if (i == 2) { G_RevealLandmine(target); }
+		}
+		else
+		{
+			// Long, but real fuse: enough time to approach and defuse. F6 resets it.
+			target->s.effect1Time = level.time ? level.time : 1;
+			target->think = G_ExplodeMissile;
+			target->nextthink = level.time + 300000;
+		}
+		trap_LinkEntity(target);
+		G_Printf("ETLAB_PRACTICE_TARGET: id=%d weapon=%d enemy=%d spotted=%d origin=%s\n",
+		         target->s.number, weapon, enemy, target->s.modelindex2, vtos(positions[i]));
+	}
+	VectorSubtract(positions[0], player->client->ps.origin, direction);
+	direction[2] -= player->client->ps.viewheight;
+	vectoangles(direction, facing);
+	SetClientViewAngle(player, facing);
+	trap_SendServerCommand(player->s.number, "cp \"ETLab: 2 hidden mines, 1 flagged mine, armed dynamite (5 min). F6: reset.\"");
+}
