+
+static qboolean CG_CustomPanelKey(int key, qboolean down)
+{
+    int i;
+    float x = 16 + cgs.wideXoffset;
+    if (CG_LimboPanel_GetClass() != PC_CUSTOM || CG_LimboPanel_GetTeam() == TEAM_SPECTATOR) return qfalse;
+    if (cgDC.cursorx < x || cgDC.cursorx > x + 410 || cgDC.cursory < 42 || cgDC.cursory > 396) return qfalse;
+    if (key == K_MOUSE1 && down)
+    {
+        i = (int)((cgDC.cursory - 100) / 30);
+        if (cgDC.cursory >= 100 && i >= 0 && i < CUSTOM_OPTION_COUNT)
+        {
+            int next = cg_customLoadout ^ (1 << i);
+            if (BG_CustomValid(next))
+            {
+                cg_customLoadout = next;
+                SOUND_SELECT;
+            }
+        }
+    }
+    return key == K_MOUSE1 || key == K_MOUSE2 || key == K_MWHEELUP || key == K_MWHEELDOWN;
+}
