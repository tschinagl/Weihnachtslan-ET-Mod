+int BG_CustomCost(int mask)
+{
+    int i, cost = 0;
+    for (i = 0; i < CUSTOM_OPTION_COUNT; i++)
+    {
+        if (mask & (1 << i)) cost += bg_customOptions[i].cost;
+    }
+    return cost;
+}
+
+qboolean BG_CustomValid(int mask)
+{
+    return mask >= 0 && !(mask & ~((1 << CUSTOM_OPTION_COUNT) - 1)) && BG_CustomCost(mask) <= CUSTOM_BUDGET;
+}
