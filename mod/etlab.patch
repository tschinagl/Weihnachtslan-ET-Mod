+/**
+ * @brief Shared availability for the Limbo menu and authoritative spawn loadout.
+ */
+qboolean BG_IsSecondaryWeaponAvailable(bg_playerclass_t *classInfo, team_t team, weapon_t primaryWeapon, int index, int *skills)
+{
+	bg_weaponclass_t *entry;
+	weapon_t bonus = BG_HeavyLoadoutAkimbo(classInfo->classNum, team, primaryWeapon);
+
+	if (index < 0 || index >= MAX_WEAPS_PER_CLASS)
+	{
+		return qfalse;
+	}
+
+	entry = &classInfo->classSecondaryWeapons[index];
+	if (!entry->weapon || entry->weapon == primaryWeapon)
+	{
+		return qfalse;
+	}
+	if (bonus && (GetWeaponTableData(entry->weapon)->type & WEAPON_TYPE_PISTOL))
+	{
+		return entry->weapon == bonus;
+	}
+
+	return BG_IsSkillAvailable(skills, entry->skill, entry->minSkillLevel);
+}
